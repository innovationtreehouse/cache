#!/bin/bash
set -euo pipefail

LIB="/usr/local/lib/facility-cache"
if [[ ! -r "$LIB/ui.sh" ]]; then
  LIB="$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd)"
fi
if [[ -r "$LIB/ui.sh" ]]; then
  # shellcheck source=/dev/null
  source "$LIB/ui.sh"
fi

usage() {
  cat <<EOF

  facility-cache  status|apply|probe|update|uninstall|log|version

  status     LAN dashboard (services, drop-ins, updates)
  apply      refresh pip/npm/uv for this network
  probe      check DNS + an optional --port
  update     install a newer GitHub Release
  uninstall  remove the client  [--keep-docker]
  log        fetchable event log  [-n N] [-f] [--json] [--path]
  version    installed package version

EOF
}

_here="$(cd "$(dirname "$0")" && pwd)"
APPLY="/usr/local/sbin/facility-cache-apply"
PROBE="/usr/local/bin/facility-cache-probe"
UPDATE="/usr/local/sbin/facility-cache-update"
UNINSTALL="/usr/local/sbin/facility-cache-uninstall"
[[ -x "$APPLY" ]] || APPLY="${_here}/../sbin/facility-cache-apply"
[[ -x "$PROBE" ]] || PROBE="${_here}/facility-cache-probe"
[[ -x "$UPDATE" ]] || UPDATE="${_here}/../sbin/facility-cache-update"
[[ -x "$UNINSTALL" ]] || UNINSTALL="${_here}/../uninstall.sh"

cmd="${1:-status}"
shift || true
case "$cmd" in
  status)     exec "$APPLY" --status "$@" ;;
  apply)      exec "$APPLY" "$@" ;;
  probe)      exec "$PROBE" "$@" ;;
  update)     exec "$UPDATE" "$@" ;;
  uninstall)  exec "$UNINSTALL" "$@" ;;
  log)
    UI_PY="$LIB/facility_ui.py"
    [[ -r "$UI_PY" ]] || UI_PY="/usr/local/lib/facility-cache/facility_ui.py"
    exec python3 "$UI_PY" "$@"
    ;;
  version|-v|--version)
    if [[ -r /usr/local/lib/facility-cache/VERSION ]]; then
      ver="$(tr -d ' \n' </usr/local/lib/facility-cache/VERSION)"
    else
      ver="unknown"
    fi
    if declare -F ui_banner >/dev/null; then
      ui_init version
      ui_banner "facility-cache-client" "v${ver}"
      ui_kv "version" "$ver" ok
      ui_kv "log" "$(ui_log_path)"
      printf '\n'
    else
      printf '%s\n' "$ver"
    fi
    ;;
  -h|--help|help) usage; exit 0 ;;
  *)
    usage >&2
    exit 2
    ;;
esac
