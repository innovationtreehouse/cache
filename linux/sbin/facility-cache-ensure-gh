#!/bin/bash
# Install or upgrade GitHub CLI (gh) from GitHub's apt repo.
set -euo pipefail

_LIB=""
if [[ -r /usr/local/lib/facility-cache/common.sh ]]; then
  _LIB=/usr/local/lib/facility-cache
else
  _LIB="$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd)"
fi
if [[ -z "$_LIB" || ! -r "$_LIB/common.sh" ]]; then
  echo "facility-cache-ensure-gh: common.sh not found" >&2
  exit 2
fi
# shellcheck disable=SC1091
source "$_LIB/common.sh"
if [[ -r "$_LIB/ensure_gh.sh" ]]; then
  # shellcheck disable=SC1091
  source "$_LIB/ensure_gh.sh"
else
  echo "facility-cache-ensure-gh: ensure_gh.sh not found" >&2
  exit 2
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "facility-cache-ensure-gh: need root" >&2
  exit 1
fi

if github_cli_ensure; then
  gh --version 2>/dev/null | head -n1 || true
  exit 0
fi
echo "facility-cache-ensure-gh: gh is not installed" >&2
exit 1
