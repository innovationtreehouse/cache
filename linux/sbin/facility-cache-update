#!/usr/bin/env python3
"""Install a newer GitHub Release of facility-cache-client, if one exists."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import ssl
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

PREFIX = Path("/usr/local")
ETC = Path("/etc/facility-cache")
VAR = Path("/var/lib/facility-cache")
LIB = PREFIX / "lib/facility-cache"
TOKEN_FILE = ETC / "github-token"
STATE_FILE = VAR / "state.json"
UA_BASE = "facility-cache-client"

_HERE = Path(__file__).resolve().parent
for _p in (LIB, _HERE.parent / "lib"):
    if (_p / "facility_ui.py").is_file():
        sys.path.insert(0, str(_p))
        break

from facility_ui import Ui, download_with_progress  # noqa: E402


def load_shell_file(path: Path) -> dict[str, str]:
    cfg: dict[str, str] = {}
    if not path.is_file():
        return cfg
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, val = line.split("=", 1)
        cfg[key.strip()] = val.strip().strip("'").strip('"')
    return cfg


def load_config() -> dict[str, str]:
    cfg = load_shell_file(LIB / "defaults")
    cfg.update(load_shell_file(ETC / "config"))
    if TOKEN_FILE.is_file():
        token = TOKEN_FILE.read_text(encoding="utf-8").strip()
        if token:
            cfg["GITHUB_TOKEN"] = token
    env_token = os.environ.get("GITHUB_TOKEN", "").strip()
    if env_token:
        cfg["GITHUB_TOKEN"] = env_token
    return cfg


def installed_version() -> str:
    path = LIB / "VERSION"
    if path.is_file():
        return path.read_text(encoding="utf-8").strip().lstrip("v")
    return "0.0.0"


def parse_version(ver: str) -> tuple[int, ...]:
    ver = ver.strip().lstrip("v")
    parts: list[int] = []
    for bit in ver.split("."):
        num = ""
        for ch in bit:
            if ch.isdigit():
                num += ch
            else:
                break
        parts.append(int(num or "0"))
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts[:3])


def newer(remote: str, local: str) -> bool:
    return parse_version(remote) > parse_version(local)


def write_state(data: dict) -> None:
    try:
        VAR.mkdir(parents=True, exist_ok=True)
        data["updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        STATE_FILE.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    except OSError:
        if os.geteuid() != 0:
            return
        raise


def github_headers(cfg: dict[str, str], accept: str | None = None) -> dict[str, str]:
    headers = {
        "User-Agent": f"{UA_BASE}/{installed_version()}",
        "Accept": accept or "application/vnd.github+json",
    }
    token = cfg.get("GITHUB_TOKEN", "")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return headers


def github_request(url: str, cfg: dict[str, str], accept: str | None = None) -> bytes:
    req = urllib.request.Request(url, headers=github_headers(cfg, accept))
    ctx = ssl.create_default_context()
    with urllib.request.urlopen(req, timeout=30, context=ctx) as resp:
        return resp.read()


def latest_release(cfg: dict[str, str]) -> dict:
    repo = cfg.get("GITHUB_REPO", "innovationtreehouse/cache")
    body = github_request(f"https://api.github.com/repos/{repo}/releases/latest", cfg)
    return json.loads(body.decode("utf-8"))


def asset_map(release: dict) -> dict[str, dict]:
    return {a["name"]: a for a in release.get("assets") or []}


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def load_manifest(release: dict, cfg: dict[str, str]) -> dict:
    assets = asset_map(release)
    if "manifest.json" not in assets:
        raise RuntimeError("release has no manifest.json asset")
    raw = github_request(
        assets["manifest.json"]["url"], cfg, accept="application/octet-stream"
    )
    return json.loads(raw.decode("utf-8"))


def install_tarball(tar_path: Path) -> None:
    with tempfile.TemporaryDirectory(prefix="facility-cache-") as tmp:
        with tarfile.open(tar_path, "r:gz") as tar:
            try:
                tar.extractall(tmp, filter="data")
            except TypeError:
                tar.extractall(tmp)
        installer = None
        for root, _dirs, files in os.walk(tmp):
            if "install.sh" in files and Path(root).name == "linux":
                installer = Path(root) / "install.sh"
                break
        if installer is None:
            raise RuntimeError("tarball missing linux/install.sh")
        subprocess.check_call(
            ["bash", str(installer), "--from-update", "--no-restart-docker"],
        )


def main() -> int:
    parser = argparse.ArgumentParser(description="Update facility-cache-client from GitHub Releases")
    parser.add_argument("--check", action="store_true", help="print versions and exit")
    parser.add_argument("--force", action="store_true", help="reinstall even if up to date")
    args = parser.parse_args()

    ui = Ui("update")
    ui.n = 5
    local = installed_version()
    ui.banner("facility-cache-client", f"update  v{local}")

    if os.geteuid() != 0 and not args.check:
        ui.fail("need root — re-run with sudo")
        ui.finish(False, "aborted")
        return 1

    cfg = load_config()
    repo = cfg.get("GITHUB_REPO", "innovationtreehouse/cache")
    auto = cfg.get("AUTO_UPDATE", "1").lower() not in ("0", "false", "no", "off")
    ui.kv("repo", repo, "work")
    ui.kv("installed", local, "ok")

    ui.step("github", "latest release")
    try:
        release = latest_release(cfg)
    except urllib.error.HTTPError as exc:
        if not args.check:
            write_state({"installed_version": local, "last_result": f"github http {exc.code}"})
        ui.step_fail("github", f"HTTP {exc.code}")
        if exc.code == 404:
            ui.note("no release yet — tag vX.Y.Z on the GitHub repo")
        ui.finish(False, "could not check GitHub")
        return 0 if not args.check else 1
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
        if not args.check:
            write_state({"installed_version": local, "last_result": f"github error: {exc}"})
        ui.step_fail("github", str(exc))
        ui.finish(False, "could not check GitHub")
        return 0 if not args.check else 1

    tag = str(release.get("tag_name") or "")
    try:
        manifest = load_manifest(release, cfg)
    except Exception as exc:  # noqa: BLE001
        if not args.check:
            write_state({"installed_version": local, "last_result": f"manifest: {exc}", "latest_tag": tag})
        ui.step_fail("github", f"manifest: {exc}")
        ui.finish(False, "release incomplete")
        return 0 if not args.check else 1

    remote = str(manifest.get("version") or tag).lstrip("v")
    ui.step_ok("github", f"{tag}  v{remote}")
    ui.kv("latest", f"v{remote}", "ok" if newer(remote, local) else "on")

    if args.check:
        if newer(remote, local):
            ui.ok(f"update available  v{local} → v{remote}")
        else:
            ui.ok("already the latest release")
        ui.finish(True, f"log {ui.log_path()}")
        return 0

    if not auto and not args.force:
        write_state(
            {
                "installed_version": local,
                "latest_version": remote,
                "last_result": "auto-update disabled",
            }
        )
        ui.warn("AUTO_UPDATE is disabled — pass --force to install")
        ui.finish(True, "no changes")
        return 0

    if not args.force and not newer(remote, local):
        write_state(
            {
                "installed_version": local,
                "latest_version": remote,
                "last_result": "up-to-date",
            }
        )
        ui.ok("already up to date")
        ui.finish(True, f"v{local}")
        return 0

    linux = (manifest.get("assets") or {}).get("linux") or {}
    name = linux.get("name")
    expect = (linux.get("sha256") or "").lower()
    if not name or not expect:
        ui.fail("manifest.json missing linux asset name/sha256")
        ui.finish(False, "bad manifest")
        return 1

    assets = asset_map(release)
    if name not in assets:
        ui.fail(f"release is missing asset {name}")
        ui.finish(False, "bad release")
        return 1

    VAR.mkdir(parents=True, exist_ok=True)
    tar_path = VAR / name
    ui.step("download", name)
    try:
        req = urllib.request.Request(
            assets[name]["url"], headers=github_headers(cfg, "application/octet-stream")
        )
        download_with_progress(
            urllib.request.urlopen,
            req,
            tar_path,
            ui,
            name,
            timeout=60,
            context=ssl.create_default_context(),
        )
        ui.step_ok("download", name)
        ui.step("verify", "sha256")
        digest = sha256_bytes(tar_path.read_bytes())
        if digest != expect:
            tar_path.unlink(missing_ok=True)
            write_state(
                {
                    "installed_version": local,
                    "latest_version": remote,
                    "last_result": "sha256 mismatch",
                }
            )
            ui.step_fail("verify", "checksum mismatch")
            ui.note(f"got {digest}")
            ui.finish(False, "refusing to install")
            return 1
        ui.step_ok("verify", digest[:12] + "…")
        ui.step("install", f"v{remote}")
        install_tarball(tar_path)
        ui.step_ok("install", f"v{remote}")
    finally:
        if tar_path.exists():
            tar_path.unlink()

    write_state(
        {
            "installed_version": remote,
            "latest_version": remote,
            "last_result": "updated",
            "from_tag": tag,
        }
    )
    ui.finish(True, f"now running v{remote}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
