#!/usr/bin/env python3
"""Install a newer GitHub Release of facility-cache-client, if one exists."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import ssl
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

PREFIX = Path("/usr/local")
ETC = Path("/etc/facility-cache")
VAR = Path("/var/lib/facility-cache")
LIB = PREFIX / "lib/facility-cache"
TOKEN_FILE = ETC / "github-token"
STATE_FILE = VAR / "state.json"
UA_BASE = "facility-cache-client"

_HERE = Path(__file__).resolve().parent
for _p in (LIB, _HERE.parent / "lib"):
    if (_p / "facility_ui.py").is_file():
        sys.path.insert(0, str(_p))
        break

from facility_ui import Ui, download_with_progress  # noqa: E402


def load_shell_file(path: Path) -> dict[str, str]:
    cfg: dict[str, str] = {}
    if not path.is_file():
        return cfg
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, val = line.split("=", 1)
        cfg[key.strip()] = val.strip().strip("'").strip('"')
    return cfg


def load_config() -> dict[str, str]:
    cfg = load_shell_file(LIB / "defaults")
    cfg.update(load_shell_file(ETC / "config"))
    if TOKEN_FILE.is_file():
        token = TOKEN_FILE.read_text(encoding="utf-8").strip()
        if token:
            cfg["GITHUB_TOKEN"] = token
    env_token = os.environ.get("GITHUB_TOKEN", "").strip()
    if env_token:
        cfg["GITHUB_TOKEN"] = env_token
    return cfg


def installed_version() -> str:
    path = LIB / "VERSION"
    if path.is_file():
        return path.read_text(encoding="utf-8").strip().lstrip("v")
    return "0.0.0"


def parse_version(ver: str) -> tuple[int, ...]:
    ver = ver.strip().lstrip("v")
    parts: list[int] = []
    for bit in ver.split("."):
        num = ""
        for ch in bit:
            if ch.isdigit():
                num += ch
            else:
                break
        parts.append(int(num or "0"))
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts[:3])


def newer(remote: str, local: str) -> bool:
    return parse_version(remote) > parse_version(local)


def write_state(data: dict) -> None:
    try:
        VAR.mkdir(parents=True, exist_ok=True)
        data["updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        STATE_FILE.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    except OSError:
        if os.geteuid() != 0:
            return
        raise


def github_headers(cfg: dict[str, str], accept: str | None = None) -> dict[str, str]:
    headers = {
        "User-Agent": f"{UA_BASE}/{installed_version()}",
        "Accept": accept or "application/vnd.github+json",
    }
    token = cfg.get("GITHUB_TOKEN", "")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return headers


def github_request(url: str, cfg: dict[str, str], accept: str | None = None) -> bytes:
    req = urllib.request.Request(url, headers=github_headers(cfg, accept))
    ctx = ssl.create_default_context()
    with urllib.request.urlopen(req, timeout=30, context=ctx) as resp:
        return resp.read()


def latest_release(cfg: dict[str, str]) -> dict:
    repo = cfg.get("GITHUB_REPO", "innovationtreehouse/cache")
    body = github_request(f"https://api.github.com/repos/{repo}/releases/latest", cfg)
    return json.loads(body.decode("utf-8"))


def repo_identity(cfg: dict[str, str]) -> dict:
    repo = cfg.get("GITHUB_REPO", "innovationtreehouse/cache")
    body = github_request(f"https://api.github.com/repos/{repo}", cfg)
    return json.loads(body.decode("utf-8"))


def identity_verdict(pinned: str, meta: dict, repo: str) -> tuple[str, str]:
    """Compare the pinned numeric repo id against what the name resolves to.

    A GitHub rename leaves the old name redirecting, so a re-registered old
    name could silently serve someone else's releases. The numeric id is
    immutable: same id under a new name is a legitimate rename ("renamed");
    a different id means the name no longer points at our repository
    ("mismatch") and nothing may be installed from it.
    """
    actual = meta.get("id")
    if str(actual) != pinned:
        return "mismatch", f"repo id {actual} != pinned {pinned}"
    full = str(meta.get("full_name") or repo)
    if full != repo:
        return "renamed", full
    return "ok", str(actual)


def asset_map(release: dict) -> dict[str, dict]:
    return {a["name"]: a for a in release.get("assets") or []}


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def verify_attestation(tar_path: Path, repo: str, token: str) -> bool:
    """Best-effort GitHub Artifact Attestation check. Never raises.

    Supply-chain nicety on top of the sha256 check above, not a replacement
    for it: if `gh` is missing, unauthenticated, or the call fails for any
    reason, the caller just logs a warning and keeps trusting sha256.
    A hard-fail flag (refuse to install without a verified attestation) can
    come later once attestations have been live for a while.

    Pins --signer-workflow to this repo's release.yml so a different
    workflow with attestations:write cannot satisfy the check, and
    --deny-self-hosted-runners so only GitHub-hosted runners count.
    """
    gh = shutil.which("gh")
    if not gh:
        return False
    env = os.environ.copy()
    if token:
        env.setdefault("GH_TOKEN", token)
    try:
        subprocess.run(
            [
                gh,
                "attestation",
                "verify",
                str(tar_path),
                "--repo",
                repo,
                "--signer-workflow",
                f"{repo}/.github/workflows/release.yml",
                "--deny-self-hosted-runners",
            ],
            check=True,
            capture_output=True,
            text=True,
            timeout=30,
            env=env,
        )
        return True
    except (subprocess.CalledProcessError, OSError, subprocess.TimeoutExpired):
        return False


def load_manifest(release: dict, cfg: dict[str, str]) -> dict:
    assets = asset_map(release)
    if "manifest.json" not in assets:
        raise RuntimeError("release has no manifest.json asset")
    raw = github_request(
        assets["manifest.json"]["url"], cfg, accept="application/octet-stream"
    )
    return json.loads(raw.decode("utf-8"))


def ensure_github_cli(tar_path: Path | None, ui: Ui) -> None:
    """Install/upgrade gh. Best-effort, never raises.

    When tar_path is set (a newly downloaded release), run that tarball's
    helper so a first upgrade onto this feature still works. Otherwise use
    the installed /usr/local/sbin/facility-cache-ensure-gh.
    """
    ui.step("gh", "GitHub CLI")
    script = None
    tmp: tempfile.TemporaryDirectory[str] | None = None
    try:
        if tar_path is not None and tar_path.is_file():
            tmp = tempfile.TemporaryDirectory(prefix="facility-cache-gh-")
            with tarfile.open(tar_path, "r:gz") as tar:
                try:
                    tar.extractall(tmp.name, filter="data")
                except TypeError:
                    tar.extractall(tmp.name)
            for root, _dirs, files in os.walk(tmp.name):
                if "facility-cache-ensure-gh" in files:
                    script = Path(root) / "facility-cache-ensure-gh"
                    break
        if script is None:
            installed = Path("/usr/local/sbin/facility-cache-ensure-gh")
            if installed.is_file():
                script = installed
        if script is None:
            ui.warn("gh helper missing — continuing")
            return
        proc = subprocess.run(
            ["bash", str(script)],
            check=False,
            capture_output=True,
            text=True,
            timeout=180,
        )
        if proc.returncode == 0 and shutil.which("gh"):
            ver = (proc.stdout or "").strip().splitlines()
            ui.step_ok("gh", ver[0] if ver else "installed")
        else:
            ui.warn("gh install skipped — attestations may be unavailable")
    except (OSError, tarfile.TarError, subprocess.TimeoutExpired):
        ui.warn("gh install skipped — attestations may be unavailable")
    finally:
        if tmp is not None:
            tmp.cleanup()


def install_tarball(tar_path: Path) -> None:
    with tempfile.TemporaryDirectory(prefix="facility-cache-") as tmp:
        with tarfile.open(tar_path, "r:gz") as tar:
            try:
                tar.extractall(tmp, filter="data")
            except TypeError:
                tar.extractall(tmp)
        installer = None
        for root, _dirs, files in os.walk(tmp):
            if "install.sh" in files and Path(root).name == "linux":
                installer = Path(root) / "install.sh"
                break
        if installer is None:
            raise RuntimeError("tarball missing linux/install.sh")
        subprocess.check_call(
            ["bash", str(installer), "--from-update", "--no-restart-docker"],
        )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Update facility-cache-client from GitHub Releases"
    )
    parser.add_argument("--check", action="store_true", help="print versions and exit")
    parser.add_argument(
        "--force", action="store_true", help="reinstall even if up to date"
    )
    args = parser.parse_args()

    ui = Ui("update")
    ui.n = 7
    local = installed_version()
    ui.banner("facility-cache-client", f"update  v{local}")

    if os.geteuid() != 0 and not args.check:
        ui.fail("need root — re-run with sudo")
        ui.finish(False, "aborted")
        return 1

    cfg = load_config()
    repo = cfg.get("GITHUB_REPO", "innovationtreehouse/cache")
    auto = cfg.get("AUTO_UPDATE", "1").lower() not in ("0", "false", "no", "off")
    ui.kv("repo", repo, "work")
    ui.kv("installed", local, "ok")

    pinned = cfg.get("GITHUB_REPO_ID", "").strip()
    if pinned:
        ui.step("identity", f"repo id {pinned}")
        try:
            meta = repo_identity(cfg)
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
            if not args.check:
                write_state(
                    {"installed_version": local, "last_result": f"github error: {exc}"}
                )
            ui.step_fail("identity", str(exc))
            ui.finish(False, "could not check GitHub")
            return 0 if not args.check else 1
        verdict, detail = identity_verdict(pinned, meta, repo)
        if verdict == "mismatch":
            # Never transient: the name resolves to a different repository, so
            # fail the unit loudly instead of the usual quiet-timer exit 0.
            if not args.check:
                write_state(
                    {"installed_version": local, "last_result": f"refused: {detail}"}
                )
            ui.step_fail("identity", detail)
            ui.note("the repository name may have been re-registered — refusing to install from it")
            ui.finish(False, "refusing to update")
            return 1
        if verdict == "renamed":
            ui.step_ok("identity", f"id {pinned}  (now named {detail})")
            ui.note(f"repo renamed to {detail} — update GITHUB_REPO in /etc/facility-cache/config")
        else:
            ui.step_ok("identity", f"id {detail}")

    ui.step("github", "latest release")
    try:
        release = latest_release(cfg)
    except urllib.error.HTTPError as exc:
        if not args.check:
            write_state(
                {"installed_version": local, "last_result": f"github http {exc.code}"}
            )
        ui.step_fail("github", f"HTTP {exc.code}")
        if exc.code == 404:
            ui.note("no release yet — tag vX.Y.Z on the GitHub repo")
        ui.finish(False, "could not check GitHub")
        return 0 if not args.check else 1
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
        if not args.check:
            write_state(
                {"installed_version": local, "last_result": f"github error: {exc}"}
            )
        ui.step_fail("github", str(exc))
        ui.finish(False, "could not check GitHub")
        return 0 if not args.check else 1

    tag = str(release.get("tag_name") or "")
    try:
        manifest = load_manifest(release, cfg)
    except Exception as exc:  # noqa: BLE001
        if not args.check:
            write_state(
                {
                    "installed_version": local,
                    "last_result": f"manifest: {exc}",
                    "latest_tag": tag,
                }
            )
        ui.step_fail("github", f"manifest: {exc}")
        ui.finish(False, "release incomplete")
        return 0 if not args.check else 1

    remote = str(manifest.get("version") or tag).lstrip("v")
    ui.step_ok("github", f"{tag}  v{remote}")
    ui.kv("latest", f"v{remote}", "ok" if newer(remote, local) else "on")

    if args.check:
        if newer(remote, local):
            ui.ok(f"update available  v{local} → v{remote}")
        else:
            ui.ok("already the latest release")
        ui.finish(True, f"log {ui.log_path()}")
        return 0

    if not auto and not args.force:
        write_state(
            {
                "installed_version": local,
                "latest_version": remote,
                "last_result": "auto-update disabled",
            }
        )
        ui.warn("AUTO_UPDATE is disabled — pass --force to install")
        ui.finish(True, "no changes")
        return 0

    if not args.force and not newer(remote, local):
        write_state(
            {
                "installed_version": local,
                "latest_version": remote,
                "last_result": "up-to-date",
            }
        )
        ui.ok("already up to date")
        ensure_github_cli(None, ui)
        ui.finish(True, f"v{local}")
        return 0

    linux = (manifest.get("assets") or {}).get("linux") or {}
    name = linux.get("name")
    expect = (linux.get("sha256") or "").lower()
    if not name or not expect:
        ui.fail("manifest.json missing linux asset name/sha256")
        ui.finish(False, "bad manifest")
        return 1

    assets = asset_map(release)
    if name not in assets:
        ui.fail(f"release is missing asset {name}")
        ui.finish(False, "bad release")
        return 1

    VAR.mkdir(parents=True, exist_ok=True)
    tar_path = VAR / name
    ui.step("download", name)
    try:
        req = urllib.request.Request(
            assets[name]["url"], headers=github_headers(cfg, "application/octet-stream")
        )
        download_with_progress(
            urllib.request.urlopen,
            req,
            tar_path,
            ui,
            name,
            timeout=60,
            context=ssl.create_default_context(),
        )
        ui.step_ok("download", name)
        ui.step("verify", "sha256")
        digest = sha256_bytes(tar_path.read_bytes())
        if digest != expect:
            tar_path.unlink(missing_ok=True)
            write_state(
                {
                    "installed_version": local,
                    "latest_version": remote,
                    "last_result": "sha256 mismatch",
                }
            )
            ui.step_fail("verify", "checksum mismatch")
            ui.note(f"got {digest}")
            ui.finish(False, "refusing to install")
            return 1
        ui.step_ok("verify", digest[:12] + "…")

        ensure_github_cli(tar_path, ui)

        ui.step("attest", "build provenance")
        if verify_attestation(tar_path, repo, cfg.get("GITHUB_TOKEN", "")):
            ui.step_ok("attest", "verified")
        else:
            ui.warn("attestation unavailable — continuing on sha256 only")

        ui.step("install", f"v{remote}")
        install_tarball(tar_path)
        ui.step_ok("install", f"v{remote}")
    finally:
        if tar_path.exists():
            tar_path.unlink()

    write_state(
        {
            "installed_version": remote,
            "latest_version": remote,
            "last_result": "updated",
            "from_tag": tag,
        }
    )
    ui.finish(True, f"now running v{remote}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
