# Shipped with each release. Local overrides go in /etc/facility-cache/config.
CACHE_HOST=cache.facility.innovationtreehouse.org
EXPECTED_IP=192.168.1.200
APT_PORT=3142
PYPI_PORT=3141
NPM_PORT=4873
DOCKER_HUB_PORT=5000
DOCKER_GHCR_PORT=5001
PROBE_TIMEOUT_SEC=1
GITHUB_REPO=innovationtreehouse/cache
# Immutable numeric id of GITHUB_REPO; the updater refuses a name that resolves elsewhere
GITHUB_REPO_ID=1343160243
AUTO_UPDATE=1
